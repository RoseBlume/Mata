+// NavigationStarting and FrameNavigationStarting share the same event ABI.
+unsafe extern "system" fn nav_query_interface(this: *mut c_void, iid: *const GUID,
+    object: *mut *mut c_void) -> HRESULT {
+    if iid.is_null() || object.is_null() { return E_POINTER; }
+    unsafe { *object = ptr::null_mut(); }
+    let requested = unsafe { *iid };
+    if requested != IID_IUNKNOWN && requested != IID_NAVIGATION_HANDLER { return E_NOINTERFACE; }
+    unsafe { *object = this; nav_add_ref(this); }
+    HRESULT(0)
+}
+unsafe extern "system" fn nav_add_ref(this: *mut c_void) -> u32 {
+    unsafe { (*this.cast::<NavigationHandler>()).refs.fetch_add(1, Ordering::Relaxed) + 1 }
+}
+pub(super) unsafe extern "system" fn nav_release(this: *mut c_void) -> u32 {
+    let this = this.cast::<NavigationHandler>();
+    let remaining = unsafe { (*this).refs.fetch_sub(1, Ordering::Release) - 1 };
+    if remaining == 0 {
+        std::sync::atomic::fence(Ordering::Acquire);
+        unsafe { drop(Box::from_raw(this)); }
+    }
+    remaining
+}
+unsafe extern "system" fn nav_invoke(this: *mut NavigationHandler, _sender: *mut CoreWebView2,
+    args: *mut NavigationStartingArgs) -> HRESULT {
+    if this.is_null() || args.is_null() { return E_POINTER; }
+    let mut raw: *mut u16 = ptr::null_mut();
+    let hr = unsafe { ((*(*args).vtbl).get_uri)(args, &mut raw) };
+    // Fail closed if the destination cannot be inspected.
+    let mut approved = false;
+    if hr.0 >= 0 && !raw.is_null() {
+        let mut len = 0;
+        while len < 8192 && unsafe { *raw.add(len) } != 0 { len += 1; }
+        if len < 8192 {
+            let uri = String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(raw, len) });
+            let guard = unsafe { &*this }.state.lock().unwrap().navigation_guard.clone();
+            approved = guard.as_ref().is_none_or(|f| f(&uri));
+        }
+    }
+    if !raw.is_null() { unsafe { CoTaskMemFree(Some(raw.cast())); } }
+    if !approved {
+        unsafe { let _ = ((*(*args).vtbl).put_cancel)(args, 1); }
+    }
+    HRESULT(0)
+}
+static NAVIGATION_VTBL: NavigationHandlerVtbl = NavigationHandlerVtbl {
