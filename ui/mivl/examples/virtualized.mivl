Window {
    title: "MIVL - 100,000 virtualized rows"
    width: 760
    height: 580
    color: "#0b1220"
    property int total: 100000
    property string selection: "Swipe, drag or scroll the wheel to browse 100,000 rows"

    Text {
        x: 24; y: 20; width: 690; height: 38
        fontSize: 24
        text: "Virtualized Mata ListView"
    }
    Text {
        x: 24; y: 64; width: 700; height: 34
        text: "Model has " + total + " rows; only visible items + cache are allocated"
    }
    ListView {
        id: list
        x: 24; y: 112; width: 420; height: 395
        model: total
        spacing: 4
        itemHeight: 40
        cacheBuffer: 120
        scrollStep: 80
        dragEnabled: true
        delegate: Button {
            height: 40
            text: "Row " + (index + 1)
            onClicked: { selection = "Clicked row " + (index + 1) }
        }
    }
    Text { x: 470; y: 130; width: 260; text: selection }
    Text { x: 470; y: 180; text: "Current scroll: " + round(list.contentY) }
    Text { x: 470; y: 222; text: "Model count: " + list.count }
    Button {
        x: 470; y: 274; width: 240
        text: "Jump to middle"
        onClicked: { list.contentY = 2200000 }
    }
    Button {
        x: 470; y: 332; width: 240
        text: "Jump to start"
        onClicked: { list.contentY = 0 }
    }
    Button {
        x: 470; y: 392; width: 240
        text: "Reduce model to 100"
        onClicked: { total = 100 }
    }
}
